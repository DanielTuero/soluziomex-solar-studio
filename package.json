{
  "name": "soluziomex-solar-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "desktop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/launch-solar-studio.ps1 -OpenApp",
